        ALTER TABLE "proj_verify_author_uniqueness"."verify_author_uniqueness_authors" ADD COLUMN IF NOT EXISTS value_name_tsvector tsvector GENERATED ALWAYS AS (to_tsvector('french'::regconfig, value->>'_name')) STORED;

        CREATE INDEX IF NOT EXISTS idx_proj_verify_author_uniqueness_verify_author_uniqueness_authors_value_name_fts_ts ON "proj_verify_author_uniqueness"."verify_author_uniqueness_authors" USING rum (value_name_tsvector);

        -- Auto-population Trigger
        CREATE OR REPLACE FUNCTION "proj_verify_author_uniqueness".trg_func_verify_author_uniqueness_authors_value_name_into_fts_words() RETURNS TRIGGER AS $$
        DECLARE
            new_arr text[];
            old_arr text[];
        BEGIN
            -- Short-circuit optimization to dramatically boost irrelevant field updates
            IF TG_OP = 'UPDATE' AND coalesce(NEW.value->>'_name', '') = coalesce(OLD.value->>'_name', '') THEN
                RETURN NULL;
            END IF;

            IF TG_OP = 'INSERT' OR TG_OP = 'UPDATE' THEN
                new_arr := regexp_split_to_array(fts.normalize(coalesce(NEW.value->>'_name', '')), '[^a-z0-9]+');
            END IF;
            IF TG_OP = 'DELETE' OR TG_OP = 'UPDATE' THEN
                old_arr := regexp_split_to_array(fts.normalize(coalesce(OLD.value->>'_name', '')), '[^a-z0-9]+');
            END IF;

            IF TG_OP = 'INSERT' THEN
                -- Insert individual words
                INSERT INTO "proj_verify_author_uniqueness".fts_words (word)
                SELECT DISTINCT unnest FROM unnest(new_arr) WHERE length(unnest) >= 3
                ON CONFLICT (word) DO UPDATE SET doc_count = fts_words.doc_count + 1;
                
                -- Insert word couples (bigrams)
                INSERT INTO "proj_verify_author_uniqueness".fts_word_couples (concat_word, separated_words)
                SELECT t1.word || t2.word, MAX(t1.word || ' ' || t2.word)
                FROM unnest(new_arr) WITH ORDINALITY AS t1(word, rn)
                JOIN unnest(new_arr) WITH ORDINALITY AS t2(word, rn) ON t2.rn = t1.rn + 1
                WHERE t1.word <> '' AND t2.word <> '' AND length(t1.word || t2.word) >= 6
                GROUP BY t1.word || t2.word
                ON CONFLICT (concat_word) DO UPDATE SET doc_count = fts_word_couples.doc_count + 1;

            ELSIF TG_OP = 'UPDATE' THEN
                -- Words added
                INSERT INTO "proj_verify_author_uniqueness".fts_words (word)
                SELECT unnest FROM unnest(new_arr) WHERE length(unnest) >= 3
                EXCEPT
                SELECT unnest FROM unnest(old_arr) WHERE length(unnest) >= 3
                ON CONFLICT (word) DO UPDATE SET doc_count = fts_words.doc_count + 1;

                -- Word Couples added
                INSERT INTO "proj_verify_author_uniqueness".fts_word_couples (concat_word, separated_words)
                SELECT added_concat, MAX(added_sep) FROM (
                    SELECT t1.word || t2.word AS added_concat, t1.word || ' ' || t2.word AS added_sep
                    FROM unnest(new_arr) WITH ORDINALITY AS t1(word, rn)
                    JOIN unnest(new_arr) WITH ORDINALITY AS t2(word, rn) ON t2.rn = t1.rn + 1
                    WHERE t1.word <> '' AND t2.word <> '' AND length(t1.word || t2.word) >= 6
                    EXCEPT
                    SELECT t1.word || t2.word AS added_concat, t1.word || ' ' || t2.word AS added_sep
                    FROM unnest(old_arr) WITH ORDINALITY AS t1(word, rn)
                    JOIN unnest(old_arr) WITH ORDINALITY AS t2(word, rn) ON t2.rn = t1.rn + 1
                    WHERE t1.word <> '' AND t2.word <> '' AND length(t1.word || t2.word) >= 6
                ) sub
                GROUP BY added_concat
                ON CONFLICT (concat_word) DO UPDATE SET doc_count = fts_word_couples.doc_count + 1;

                -- Words removed
                WITH decremented_words AS (
                    UPDATE "proj_verify_author_uniqueness".fts_words
                    SET doc_count = fts_words.doc_count - 1
                    WHERE word IN (
                        SELECT unnest FROM unnest(old_arr) WHERE length(unnest) >= 3
                        EXCEPT
                        SELECT unnest FROM unnest(new_arr) WHERE length(unnest) >= 3
                    )
                    RETURNING word, doc_count
                )
                DELETE FROM "proj_verify_author_uniqueness".fts_words WHERE word IN (SELECT word FROM decremented_words WHERE doc_count <= 0);
                
                -- Word couples removed
                WITH decremented_couples AS (
                    UPDATE "proj_verify_author_uniqueness".fts_word_couples
                    SET doc_count = fts_word_couples.doc_count - 1
                    WHERE concat_word IN (
                        SELECT t1.word || t2.word
                        FROM unnest(old_arr) WITH ORDINALITY AS t1(word, rn)
                        JOIN unnest(old_arr) WITH ORDINALITY AS t2(word, rn) ON t2.rn = t1.rn + 1
                        WHERE t1.word <> '' AND t2.word <> '' AND length(t1.word || t2.word) >= 6
                        EXCEPT
                        SELECT t1.word || t2.word
                        FROM unnest(new_arr) WITH ORDINALITY AS t1(word, rn)
                        JOIN unnest(new_arr) WITH ORDINALITY AS t2(word, rn) ON t2.rn = t1.rn + 1
                        WHERE t1.word <> '' AND t2.word <> '' AND length(t1.word || t2.word) >= 6
                    )
                    RETURNING concat_word, doc_count
                )
                DELETE FROM "proj_verify_author_uniqueness".fts_word_couples WHERE concat_word IN (SELECT concat_word FROM decremented_couples WHERE doc_count <= 0);
                
            ELSIF TG_OP = 'DELETE' THEN
                -- Words removed
                WITH decremented_words AS (
                    UPDATE "proj_verify_author_uniqueness".fts_words
                    SET doc_count = fts_words.doc_count - 1
                    WHERE word IN (
                        SELECT DISTINCT unnest FROM unnest(old_arr) WHERE length(unnest) >= 3
                    )
                    RETURNING word, doc_count
                )
                DELETE FROM "proj_verify_author_uniqueness".fts_words WHERE word IN (SELECT word FROM decremented_words WHERE doc_count <= 0);
                
                -- Word couples removed
                WITH decremented_couples AS (
                    UPDATE "proj_verify_author_uniqueness".fts_word_couples
                    SET doc_count = fts_word_couples.doc_count - 1
                    WHERE concat_word IN (
                        SELECT t1.word || t2.word
                        FROM unnest(old_arr) WITH ORDINALITY AS t1(word, rn)
                        JOIN unnest(old_arr) WITH ORDINALITY AS t2(word, rn) ON t2.rn = t1.rn + 1
                        WHERE t1.word <> '' AND t2.word <> '' AND length(t1.word || t2.word) >= 6
                    )
                    RETURNING concat_word, doc_count
                )
                DELETE FROM "proj_verify_author_uniqueness".fts_word_couples WHERE concat_word IN (SELECT concat_word FROM decremented_couples WHERE doc_count <= 0);
            END IF;
            RETURN NULL;
        END;
        $$ LANGUAGE plpgsql;

        DROP TRIGGER IF EXISTS trg_verify_author_uniqueness_authors_value_name_into_fts_words ON "proj_verify_author_uniqueness"."verify_author_uniqueness_authors";
        CREATE TRIGGER trg_verify_author_uniqueness_authors_value_name_into_fts_words
        AFTER INSERT OR UPDATE OR DELETE ON "proj_verify_author_uniqueness"."verify_author_uniqueness_authors"
        FOR EACH ROW EXECUTE FUNCTION "proj_verify_author_uniqueness".trg_func_verify_author_uniqueness_authors_value_name_into_fts_words();
        ALTER TABLE "proj_verify_author_uniqueness"."verify_author_uniqueness_authors" ADD COLUMN IF NOT EXISTS value_tsvector tsvector GENERATED ALWAYS AS (setweight(to_tsvector('french'::regconfig, coalesce(value->>'_name', '')), 'A')) STORED;
CREATE INDEX IF NOT EXISTS idx_proj_verify_author_uniqueness_verify_author_uniqueness_authors_value_tsvector ON "proj_verify_author_uniqueness"."verify_author_uniqueness_authors" USING rum (value_tsvector);

