        CREATE TRIGGER trg_verify_editor_uniqueness_editors_value_name_into_fts_words
        AFTER INSERT OR UPDATE OR DELETE ON "proj_verify_editor_uniqueness"."verify_editor_uniqueness_editors"
        FOR EACH ROW EXECUTE FUNCTION "proj_verify_editor_uniqueness".trg_func_verify_editor_uniqueness_editors_value_name_into_fts_words();
